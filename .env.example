# API
APP_ENV=development
APP_API_KEY=
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_MB=20

# LLM provider: mock | openai | gemini | bedrock
LLM_PROVIDER=mock
LLM_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
GEMINI_API_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0

# Optional provider embeddings. Local feature hashing is the zero-key fallback.
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MODEL=

# Used by the frontend server-side proxy. Never expose a backend secret as NEXT_PUBLIC_*.
BACKEND_API_URL=http://localhost:8000
BACKEND_API_KEY=

# Optional video URL for a real lesson asset in the demo UI.
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Supabase Auth: used only on trusted servers (never expose a service-role key).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
